# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# iCloud sync duplicates (this project previously lived in an iCloud-synced
# folder; these "name 2.ext" copies corrupt builds and must never be tracked).
# The counter keeps climbing past 2, so match any " <number>" suffix.
* [0-9]
* [0-9].*
* [0-9][0-9]
* [0-9][0-9].*
**/* [0-9]
**/* [0-9].*
**/* [0-9][0-9]
**/* [0-9][0-9].*
